{
  "kernel_image": "/path/to/vmlinux",
  "root_drive": "/path/to/rootfs.ext4",
  "firecracker_executable": "firecracker",
  "vcpu_count": 2,
  "mem_size_mib": 2048,
  "boot_args": "console=ttyS0 reboot=k panic=1 pci=off",
  "guest_ip": "172.16.0.2",
  "tap_device": "tap0",
  "guest_mac": "06:00:AC:10:00:02",
  "ssh_user": "root",
  "ssh_identity_file": "",
  "startup_timeout_seconds": 120,
  "shared_mount": {
    "host_dir": "/path/to/shared/dir",
    "guest_path": "/mnt/share",
    "backend": "ssh",
    "tag": "share"
  }
}
